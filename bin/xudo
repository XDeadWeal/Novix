#!/bin/bash

XUDO_DIR="$(dirname "$(readlink -f "$0")")/../etc/xudo"
PLUGINS_DIR="$(dirname "$(readlink -f "$0")")/../plugins"
INSTALLED_JSON="$XUDO_DIR/installed.json"

mkdir -p "$XUDO_DIR" "$PLUGINS_DIR"

if [ ! -f "$INSTALLED_JSON" ]; then
    echo '{"plugins": {}}' > "$INSTALLED_JSON"
fi

if ! command -v jq &> /dev/null; then
    echo "Error: jq required"
    exit 1
fi

if ! command -v git &> /dev/null; then
    echo "Error: git required"
    exit 1
fi