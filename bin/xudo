#!/bin/bash

# XUDO - Novix Plugin Manager
# Full version with GitHub support

XUDO_VERSION="1.0.0"
XUDO_DIR="$(dirname "$0")"
ETC_DIR="${XUDO_DIR}/../etc/xudo"
PLUGINS_DIR="${XUDO_DIR}/../plugins"
INSTALLED_JSON="${ETC_DIR}/installed.json"

check_deps() {
    if ! command -v jq >/dev/null 2>&1; then
        echo "Error: Missing dependency: jq"
        exit 1
    fi
    if ! command -v git >/dev/null 2>&1; then
        echo "Error: Missing dependency: git"
        exit 1
    fi
}

load_installed() {
    if [ -f "$INSTALLED_JSON" ]; then
        INSTALLED=$(cat "$INSTALLED_JSON")
    else
        INSTALLED='{"plugins": {}}'
    fi
}

save_installed() {
    echo "$INSTALLED" > "$INSTALLED_JSON"
}

is_installed() {
    local plugin_name="$1"
    echo "$INSTALLED" | jq -e ".plugins.\"${plugin_name}\"" >/dev/null 2>&1
}

get_plugin_info() {
    local plugin_dir="$1"
    local field="$2"
    if [ -f "${plugin_dir}/plugin.json" ]; then
        jq -r ".${field}" "${plugin_dir}/plugin.json" 2>/dev/null
    fi
}

cmd_install() {
    local url="$1" no_prompt=false
    if [ "$2" = "-p" ]; then no_prompt=true; fi
    local repo_url="$url"
    local repo_name=$(basename "$repo_url" | sed "s/\\.git$//")
    local plugin_name=$(echo "$repo_name" | tr '[:upper:]' '[:lower:]')
    local plugin_dir="${PLUGINS_DIR}/${plugin_name}"
    if is_installed "$plugin_name"; then
        echo "Plugin ${plugin_name} is already installed"
        return 0
    fi
    if [ "$no_prompt" = false ]; then
        echo "Installing from: ${repo_url}"
        read -p "Continue? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then return 0; fi
    fi
    echo "Cloning..."
    if ! git clone --depth 1 "$repo_url" "$plugin_dir" 2>/dev/null; then
        echo "Error: Failed to clone"; return 1
    fi
    if [ ! -f "${plugin_dir}/plugin.json" ]; then
        echo "Error: plugin.json not found"; rm -rf "$plugin_dir"; return 1
    fi
    local plugin_version=$(get_plugin_info "$plugin_dir" "version")
    echo "Plugin: ${plugin_name} v${plugin_version}"
    if [ -f "${plugin_dir}/install.sh" ]; then
        (cd "$plugin_dir" && bash install.sh) || true
    fi
    INSTALLED=$(echo "$INSTALLED" | jq ".plugins + \"{\"${plugin_name}\": {\"version\": \"${plugin_version}\", \"url\": \"${repo_url}\", \"installed_at\": \"$(date -Iseconds)\"}}\")"
    save_installed
    echo "Plugin ${plugin_name} installed!"
}

cmd_uninstall() {
    local plugin_name="$1" plugin_dir="${PLUGINS_DIR}/${plugin_name}"
    if [ ! -d "$plugin_dir" ]; then echo "Error: Not found"; return 1; fi
    if [ -f "${plugin_dir}/uninstall.sh" ]; then (cd "$plugin_dir" && bash uninstall.sh) || true; fi
    rm -rf "$plugin_dir"
    INSTALLED=$(echo "$INSTALLED" | jq "del(.plugins.\"${plugin_name}\")")"
    save_installed
    echo "Plugin ${plugin_name} uninstalled!"
}

cmd_update() {
    local target="$1"
    if [ "$target" = "all" ]; then
        load_installed
        for plugin_name in $(echo "$INSTALLED" | jq -r '.plugins | keys[]'); do
            echo "Updating ${plugin_name}..."
            local plugin_dir="${PLUGINS_DIR}/${plugin_name}"
            local repo_url=$(echo "$INSTALLED" | jq -r ".plugins.\"${plugin_name}\".url")
            if [ -d "$plugin_dir" ] && [ -n "$repo_url" ]; then
                (cd "$plugin_dir" && git pull) || true
                if [ -f "${plugin_dir}/update.sh" ]; then bash "${plugin_dir}/update.sh" || true; fi
                local new_version=$(get_plugin_info "$plugin_dir" "version")
                INSTALLED=$(echo "$INSTALLED" | jq ".plugins.\"${plugin_name}\".version = \"${new_version}\"")"
                save_installed
                echo "${plugin_name} updated to v${new_version}"
            fi
        done
    else
        local plugin_name="$target" plugin_dir="${PLUGINS_DIR}/${plugin_name}"
        if [ ! -d "$plugin_dir" ]; then echo "Error: Not found"; return 1; fi
        local repo_url=$(echo "$INSTALLED" | jq -r ".plugins.\"${plugin_name}\".url")
        (cd "$plugin_dir" && git pull) || true
        if [ -f "${plugin_dir}/update.sh" ]; then bash "${plugin_dir}/update.sh" || true; fi
        local new_version=$(get_plugin_info "$plugin_dir" "version")
        INSTALLED=$(echo "$INSTALLED" | jq ".plugins.\"${plugin_name}\".version = \"${new_version}\"")"
        save_installed
        echo "${plugin_name} updated to v${new_version}"
    fi
}

cmd_list() {
    load_installed
    local plugins=$(echo "$INSTALLED" | jq -r '.plugins | keys[]')
    if [ -z "$plugins" ]; then echo "No plugins installed"; return 0; fi
    echo "Installed Plugins:"
    for plugin_name in $plugins; do
        local version=$(echo "$INSTALLED" | jq -r ".plugins.\"${plugin_name}\".version")"
        printf "%-20s v%s\n" "$plugin_name" "$version"
    done
}

cmd_info() {
    local plugin_name="$1" plugin_dir="${PLUGINS_DIR}/${plugin_name}"
    if [ ! -d "$plugin_dir" ] || [ ! -f "${plugin_dir}/plugin.json" ]; then
        echo "Error: Plugin not found"; return 1
    fi
    echo "Plugin Information:"
    echo "name: $(get_plugin_info "$plugin_dir" "name")"
    echo "version: $(get_plugin_info "$plugin_dir" "version")"
    echo "description: $(get_plugin_info "$plugin_dir" "description")"
    echo "author: $(get_plugin_info "$plugin_dir" "author")"
    echo "license: $(get_plugin_info "$plugin_dir" "license")"
    echo "homepage: $(get_plugin_info "$plugin_dir" "homepage")"
}

cmd_help() {
    echo "XUDO - Novix Plugin Manager v${XUDO_VERSION}"
    echo "Usage:"
    echo "  xudo install <url> [-p]    Install plugin from GitHub URL"
    echo "  xudo uninstall <name>     Uninstall a plugin"
    echo "  xudo update all           Update all plugins"
    echo "  xudo update <name>       Update specific plugin"
    echo "  xudo list                List installed plugins"
    echo "  xudo info <name>         Show plugin information"
    echo "  xudo help                Show this help"
    echo "Flags: -p (skip prompt)"
}

main() {
    check_deps
    load_installed
    if [ $# -eq 0 ]; then cmd_help; exit 0; fi
    case "$1" in
        install) shift; cmd_install "$@";;
        uninstall) shift; cmd_uninstall "$@";;
        update) shift; cmd_update "$@";;
        list) cmd_list;;
        info) shift; cmd_info "$@";;
        help|--help|-h) cmd_help;;
        *) echo "Error: Unknown command"; cmd_help; exit 1;;
    esac
}
main "$@"
